package xmpp4cj.connection

public class Xmpp {
    /**  
     * Logger 实例，用于记录日志信息。
     */
    private static let LOGGER = getGlobalLogger(("name", "Smack"))

    private static let SMACK_ORG: String = "xmpp4cj"

    public static let SMACK_PACKAGE: String = SMACK_ORG + ".xmpp"

    /**
     * Returns the Smack version information, eg "1.3.0".
     *
     * @return the Smack version information.
     */
    public static func getVersion(): String {
        return XmppInitialization.XMPP_VERSION
    }

    private static let NOTICE_RESOURCE: String = SMACK_PACKAGE + "/NOTICE"

    /**
     * Get the stream of the NOTICE file of Smack.
     * <p>
     * This license of Smack requires that the contents of this NOTICE text file are shown "…within a display generated by
     * the Derivative Works, if and wherever such third-party notices normally appear.".
     * </p>
     *
     * @return the stream of the NOTICE file of Smack.
     */
    public static func getNoticeStream(): InputStream {
        // let res: InputStream = FileUtils.getInputStreamForClasspathFile(NOTICE_RESOURCE)
        // return res
        throw Exception("TODO")
    }

    public static func ensureInitialized() {
        if (XmppConfiguration.isXmppInitialized()) {
            return
        }
        let version: String = getVersion()
        LOGGER.warn("Smack ${version} has been initialized")
    }
}

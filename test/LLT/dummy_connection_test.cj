import std.collection.*
import std.collection.concurrent.*
import std.random.*
import std.time.*
import cangjie_tpc::xmpp4cj.packet.*
import cangjie_tpc::xmpp4cj.jid.*
import cangjie_tpc::xmpp4cj.connection.*
import cangjie_tpc::xmpp4cj.tcp.*

/**
 * A dummy implementation of {@link XMPPConnection}, intended to be used during
 * unit tests.
 *
 * Instances store any packets that are delivered to be send using the
 * {@link #sendStanza(Stanza)} method in a blocking queue. The content of this queue
 * can be inspected using {@link #getSentPacket()}. Typically these queues are
 * used to retrieve a message that was generated by the client.
 *
 * Packets that should be processed by the client to simulate a received stanza
 * can be delivered using the {@linkplain #processStanza(Stanza)} method.
 * It invokes the registered stanza interceptors and listeners.
 *
 * @see XMPPConnection
 */
public open class DummyConnection <: AbstractXMPPConnection {
    private let queue: BlockingQueue<TopLevelStreamElement> = BlockingQueue<TopLevelStreamElement>()

    public static func getDummyConfigurationBuilder(): ConnectionConfigurationBuilder {
        return DummyConnectionConfiguration
            .builder()
            .setXmppDomain(JidCreate.domainBareFrom("example.org"))
            .setUsernameAndPassword("dummy", "dummypass")
    }

    public init() {
        this(getDummyConfigurationBuilder().build())
    }

    public init(username: String, password: String, serviceName: String) {
        this(
            getDummyConfigurationBuilder()
            .setUsernameAndPassword(username, password)
            .setXmppDomain(JidCreate.domainBareFrom(serviceName))
            .build())
    }

    public init(configuration: ConnectionConfiguration) {
        super(configuration)
    }

    public func initFor() {
        for (listener in XMPPConnectionRegistry.getConnectionCreationListeners()) {
            listener.connectionCreated(this)
        }
        user = getUserJid()
    }

    private func getUserJid(): EntityFullJid {
        if (let Some(v) <- config.getResource()) {
            return JidCreate.entityFullFrom("${config.getUsername()}@${config.getXMPPServiceDomain()}/v")
        } else {
            return JidCreate.entityFullFrom("${config.getUsername()}@${config.getXMPPServiceDomain()}/Test")
        }
    }

    protected override func connectInternal(): Unit {
        connected = true
        let random: Random = Random()
        streamId = "dummy-${random.nextInt64(DateTime.nowUTC().nanosecond/1000)}"
    }

    protected override func shutdown(): Unit {
        user = None
        authenticated = false
        // callConnectionClosedListener()
    }

    public override func instantShutdown(): Unit {
        shutdown()
    }

    public override func isSecureConnection(): Bool {
        return false
    }

    public override func isUsingCompression(): Bool {
        return false
    }

    public override func loginInternal(username: ?String, password: ?String, resource: ?Resourcepart): Unit {
        user = getUserJid()
        authenticated = true
    }

    public override func sendNonza(element: Nonza): Unit {
        queue.enqueue(element)
    }

    protected override func sendStanzaInternal(packet: Stanza): Unit {
        queue.enqueue(packet)
    }

    /**
     * Returns the number of packets that's sent through {@link #sendStanza(Stanza)} and
     * that has not been returned by {@link #getSentPacket()}.
     *
     * @return the number of packets which are in the queue.
     */
    public func getNumberOfSentPackets(): Int64 {
        return queue.size
    }

    /**
     * Returns the first stanza that's sent through {@link #sendStanza(Stanza)}
     * and that has not been returned by earlier calls to this method.
     *
     * @param <P> the top level stream element class.
     * @return a sent packet.
     */
    public func getSentPacket(): ?TopLevelStreamElement {
        return getSentPacket(5 * 60)
    }

    /**
     * Returns the first stanza that's sent through {@link #sendStanza(Stanza)}
     * and that has not been returned by earlier calls to this method. This
     * method will block for up to the specified number of seconds if no packets
     * have been sent yet.
     *
     * @param wait how long to wait in seconds.
     * @param <P> the top level stream element class.
     * @return a sent packet.
     */
    public func getSentPacket(wait: Int64): ?TopLevelStreamElement {
        return queue.remove(Duration.second * wait)
    }

    /**
     * Processes a stanza through the installed stanza collectors and listeners
     * and letting them examine the stanza to see if they are a match with the
     * filter.
     *
     * @param packet the stanza to process.
     */
    public override func processStanza(packet: Stanza): Unit {
        invokeStanzaCollectorsAndNotifyRecvListeners(packet)
    }

    /**
     * Enable stream feature.
     *
     * @param streamFeature the stream feature.
     */
    public func enableStreamFeature(streamFeature: ExtensionElement): Unit {
        addStreamFeature(streamFeature)
    }

    public static func newConnectedDummyConnection(): DummyConnection {
        let dummyConnection: DummyConnection = DummyConnection()
        dummyConnection.connect()
        dummyConnection.login()
        return dummyConnection
    }

    public override func getClass(): ClassId {
        "DummyConnection"
    }

    public static func schedule(runnable: Runnable, delay: Duration): ScheduledAction {
        return XMPP_REACTOR.schedule(runnable, delay, ScheduledActionKind.NonBlocking)
    }
}

public class DummyConnectionConfiguration <: ConnectionConfiguration {
    public DummyConnectionConfiguration(builder: DummyConnectionConfigurationBuilder) {
        super(builder)
    }

    public static func builder(): DummyConnectionConfigurationBuilder {
        return DummyConnectionConfigurationBuilder()
    }
}

public class DummyConnectionConfigurationBuilder <: ConnectionConfigurationBuilder {
    public init() {
        setSecurityMode(ConnectionConfigurationSecurityMode.disabled)
    }

    public override func build(): DummyConnectionConfiguration {
        return DummyConnectionConfiguration(this)
    }

}
